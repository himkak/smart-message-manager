# Application
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./smart_messages.db
# Use a long, random value before enabling Google OAuth locally.
APP_SESSION_SECRET=replace-with-a-long-random-local-secret
# Origin(s) allowed to call the API with credentials (the frontend dev server).
# Comma-separate multiple origins, e.g. to also allow a LAN IP for mobile access:
# FRONTEND_ORIGIN=http://localhost:5173,http://192.168.1.7:5173
FRONTEND_ORIGIN=http://localhost:5173

# Azure OpenAI / Microsoft Foundry (not required for Phase 0)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure AI Search (not required for Phase 0)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=smart-messages-v1

# Gmail OAuth (not required for Phase 0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
